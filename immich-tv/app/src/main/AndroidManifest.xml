<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android TV / Leanback required — limits to TV devices like the Shield -->
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <!-- Shield TV has no touchscreen -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Shield TV supports 4K and is always landscape -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- Shield TV ships with a gamepad; declare optional so it's not a hard requirement -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ImmichTV"
        android:banner="@drawable/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
